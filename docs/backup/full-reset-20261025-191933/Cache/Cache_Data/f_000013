<!doctype html>
<html lang="zh">
<head>
<meta charset="utf-8">
<title>生境 · 启动序列（U → Z → 界面展开）</title>
<style>
  :root {
    --accent: #35f0ce;
    --bg: #04080c;
    --ink: #cfe6f2;
    --line: rgba(255,255,255,.06);
  }
  * { box-sizing: border-box; }
  html, body { height: 100%; overflow: hidden; }
  body {
    margin: 0;
    background:
      radial-gradient(820px 560px at 50% 46%, rgba(53,240,206,.05), transparent 68%),
      radial-gradient(1200px 760px at 50% 116%, rgba(60,120,200,.03), transparent 62%),
      var(--bg);
    color: var(--ink);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Microsoft YaHei", sans-serif;
  }

  /* ═══════════════ 主界面骨架（最后显现） ═══════════════ */
  .app { position: fixed; inset: 0; display: flex; flex-direction: column; }

  .topbar {
    height: 38px; flex-shrink: 0;
    display: flex; align-items: center; gap: 9px;
    padding-left: 52px;            /* 给停靠后的 logo 让位 */
    border-bottom: 1px solid var(--line);
    opacity: 0;
    animation: uiTop .55s cubic-bezier(.16,1,.3,1) 4.30s forwards;
  }
  .brand { display: flex; align-items: baseline; gap: 11px; }
  .brand .cn { font-size: 12.5px; letter-spacing: .16em; color: rgba(232,246,255,.86); }
  .brand .en { font-size: 9px; letter-spacing: .3em; color: rgba(143,199,219,.4); }
  .brand .sub { font-size: 8px; letter-spacing: .12em; color: rgba(91,120,138,.45); }

  .body { flex: 1; display: flex; min-height: 0; }

  .rail-left {
    width: 236px; flex-shrink: 0;
    border-right: 1px solid var(--line);
    padding: 14px 0;
    opacity: 0; transform: translateX(-10px);
    animation: uiLeft .6s cubic-bezier(.16,1,.3,1) 4.55s forwards;
  }
  .main {
    flex: 1; min-width: 0;
    padding: 22px 26px;
    opacity: 0; transform: translateY(8px);
    animation: uiMain .65s cubic-bezier(.16,1,.3,1) 4.90s forwards;
  }
  .rail-right {
    width: 268px; flex-shrink: 0;
    border-left: 1px solid var(--line);
    padding: 16px 18px;
    opacity: 0; transform: translateX(10px);
    animation: uiRight .6s cubic-bezier(.16,1,.3,1) 5.25s forwards;
  }

  /* 骨架里的假块 */
  .ghost {
    border-radius: 7px;
    background: linear-gradient(140deg, rgba(53,240,206,.085), rgba(53,240,206,.028));
    border: 1px solid rgba(53,240,206,.14);
    margin-bottom: 11px;
  }
  .rail-left .ghost { height: 42px; margin: 0 12px 9px; }
  .rail-left .ghost:first-child { height: 34px; }
  .main .bubble { display: flex; gap: 11px; margin-bottom: 20px; }
  .main .avatar { width: 30px; height: 30px; border-radius: 50%; flex-shrink: 0;
    background: rgba(53,240,206,.16); border: 1px solid rgba(53,240,206,.3); }
  .main .bubble > div:last-child { flex: 1; }
  .main .line { height: 9px; border-radius: 5px; margin-bottom: 8px;
    background: linear-gradient(90deg, rgba(207,230,242,.16), rgba(207,230,242,.055)); }
  .main .line.w60 { width: 60%; }
  .main .line.w85 { width: 85%; }
  .main .line.w40 { width: 40%; }
  .rail-right .ghost { height: 56px; }
  .rail-right .radar { height: 150px; border-radius: 10px;
    border: 1px solid rgba(53,240,206,.18);
    background: radial-gradient(circle at 50% 50%, rgba(53,240,206,.13), transparent 62%);
    margin-bottom: 12px; }

  /* ═══════════════ 中央 logo（会移动 / 变形 / 停靠） ═══════════════ */
  .logo-stage {
    position: fixed;
    left: 50%; top: 50%;
    width: 320px; height: 320px;
    margin: -160px 0 0 -160px;
    z-index: 40;
    pointer-events: none;
    /* 移动 + 缩小，从第 2.7s 开始，0.95s 完成 */
    transform-origin: center center;
    animation: dock 0.95s cubic-bezier(.55,.06,.28,1) 2.70s forwards;
  }

  /* 停靠终点：屏幕左上角标题栏位置，320 * 0.075 = 24px */
  @keyframes dock {
    0%   { transform: translate(0, 0) scale(1); }
    100% { transform: translate(calc(-50vw + 24px), calc(-50vh + 19px)) scale(0.088); }
  }

  .layer { position: absolute; inset: 0; display: grid; place-items: center; }
  .layer svg { display: block; overflow: visible; }

  /* U 层：移动过程中淡出 */
  .layer-u { animation: uOut .7s ease 2.85s forwards; }
  @keyframes uOut { to { opacity: 0; } }

  /* Z 层：移动过程中淡入 */
  .layer-z { opacity: 0; animation: zIn .7s ease 3.00s forwards; }
  @keyframes zIn { to { opacity: 1; } }

  /* ═══════════════ U 的逐笔生长 ═══════════════ */
  @keyframes draw { to { stroke-dashoffset: 0; } }
  .u-trunk { stroke-dasharray: 34; stroke-dashoffset: 34; animation: draw .58s cubic-bezier(.4,0,.2,1) .12s forwards; }
  .u-b1 { stroke-dasharray: 29; stroke-dashoffset: 29; animation: draw .40s ease-out .72s forwards; }
  .u-b2 { stroke-dasharray: 29; stroke-dashoffset: 29; animation: draw .40s ease-out .84s forwards; }
  .u-b3 { stroke-dasharray: 26; stroke-dashoffset: 26; animation: draw .40s ease-out .96s forwards; }
  .u-b4 { stroke-dasharray: 26; stroke-dashoffset: 26; animation: draw .40s ease-out 1.08s forwards; }

  @keyframes pop {
    0% { transform: scale(0); opacity: 0; }
    62% { transform: scale(1.55); opacity: 1; }
    100% { transform: scale(1); opacity: 1; }
  }
  .u-tip { transform-box: fill-box; transform-origin: center; transform: scale(0); opacity: 0; }
  .u-t1 { animation: pop .34s cubic-bezier(.34,1.56,.64,1) 1.05s forwards; }
  .u-t2 { animation: pop .34s cubic-bezier(.34,1.56,.64,1) 1.14s forwards; }
  .u-t3 { animation: pop .34s cubic-bezier(.34,1.56,.64,1) 1.24s forwards; }
  .u-t4 { animation: pop .34s cubic-bezier(.34,1.56,.64,1) 1.33s forwards; }

  @keyframes coreIn {
    0% { transform: scale(0); opacity: 0; }
    55% { transform: scale(1.7); opacity: 1; }
    100% { transform: scale(1); opacity: .95; }
  }
  .u-core { transform-box: fill-box; transform-origin: center; transform: scale(0); opacity: 0;
    animation: coreIn .46s cubic-bezier(.34,1.56,.64,1) 1.44s forwards; }
  .u-halo { transform-box: fill-box; transform-origin: center; opacity: 0;
    animation: fadeIn .6s ease 1.56s forwards; }

  @keyframes fadeIn { to { opacity: .18; } }

  /* ═══════════════ Z 的显现（简化版，尺寸小时细节会自动消失） ═══════════════ */
  @keyframes hexDraw { to { stroke-dashoffset: 0; } }
  .z-hex { stroke-dasharray: 264; stroke-dashoffset: 264; animation: hexDraw .55s ease-out 3.05s forwards; }
  @keyframes zCoreIn {
    0% { transform: scale(.4); opacity: 0; }
    100% { transform: scale(1); opacity: .95; }
  }
  .z-core { transform-box: fill-box; transform-origin: center; opacity: 0;
    animation: zCoreIn .45s cubic-bezier(.34,1.56,.64,1) 3.40s forwards; }
  .z-legs { opacity: 0; animation: fadeIn2 .4s ease 3.30s forwards; }
  @keyframes fadeIn2 { to { opacity: .45; } }

  /* ═══════════════ 文字（跟着 logo 一起，然后消失） ═══════════════ */
  .wordmark {
    position: fixed; left: 50%; top: calc(50% + 190px);
    transform: translateX(-50%);
    text-align: center;
    z-index: 41;
    opacity: 0;
    animation: wordIn .7s cubic-bezier(.16,1,.3,1) 1.55s forwards,
               wordOut .45s ease 2.65s forwards;
  }
  .wordmark .cn { font-size: 32px; font-weight: 300; letter-spacing: .42em; text-indent: .42em; color: #e8f6ff; }
  .wordmark .en { margin-top: 8px; font-size: 9.5px; letter-spacing: .32em; text-indent: .32em; color: rgba(143,199,219,.5); }
  .wordmark .tag { margin-top: 5px; font-size: 8px; letter-spacing: .16em; color: rgba(91,120,138,.55); }
  @keyframes wordIn { from { opacity: 0; transform: translateX(-50%) translateY(8px); } to { opacity: 1; transform: translateX(-50%) translateY(0); } }
  @keyframes wordOut { to { opacity: 0; } }

  /* ═══════════════ 进度条 ═══════════════ */
  .bar-wrap {
    position: fixed; left: 50%; bottom: 70px; transform: translateX(-50%);
    width: 200px; z-index: 41;
    opacity: 0;
    animation: barIn .35s ease .25s forwards, barOut .35s ease 2.55s forwards;
  }
  @keyframes barIn { to { opacity: 1; } }
  @keyframes barOut { to { opacity: 0; } }
  .bar { height: 1.5px; border-radius: 2px; background: rgba(255,255,255,.07); overflow: hidden; }
  .bar i {
    display: block; height: 100%; width: 0; border-radius: 2px;
    background: linear-gradient(90deg, rgba(53,240,206,.3), var(--accent));
    box-shadow: 0 0 9px rgba(53,240,206,.55);
    animation: fill 2.35s cubic-bezier(.4,.05,.2,1) .3s forwards;
  }
  @keyframes fill { to { width: 100%; } }
  .status {
    margin-top: 10px; text-align: center; height: 12px;
    font: 8.5px ui-monospace, monospace; letter-spacing: .16em; color: rgba(91,120,138,.65);
  }

  /* ── UI 各块的显现关键帧（之前漏了这四条，所以一直是透明的） ── */
  @keyframes uiTop   { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes uiLeft  { from { opacity: 0; transform: translateX(-10px); } to { opacity: 1; transform: translateX(0); } }
  @keyframes uiMain  { from { opacity: 0; transform: translateY(8px); }  to { opacity: 1; transform: translateY(0); } }
  @keyframes uiRight { from { opacity: 0; transform: translateX(10px); }  to { opacity: 1; transform: translateX(0); } }

  /* ═══════════════ 背景网格（UI 展开后才有） ═══════════════ */
  .grid-bg {
    position: fixed; inset: 0; z-index: 0; pointer-events: none;
    background-image:
      linear-gradient(rgba(53,240,206,.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(53,240,206,.045) 1px, transparent 1px);
    background-size: 44px 44px;
    -webkit-mask-image: radial-gradient(circle at 50% 42%, #000 12%, transparent 68%);
    mask-image: radial-gradient(circle at 50% 42%, #000 12%, transparent 68%);
    opacity: 0;
    animation: gridIn 1.1s ease 4.05s forwards;
  }
  @keyframes gridIn { to { opacity: 1; } }

  /* ═══════════════ 控件 ═══════════════ */
  .replay {
    position: fixed; top: 18px; right: 20px; z-index: 60;
    padding: 6px 14px;
    border: 1px solid rgba(53,240,206,.26);
    border-radius: 6px;
    background: rgba(53,240,206,.06);
    color: var(--accent);
    font: 10px ui-monospace, monospace;
    letter-spacing: .1em;
    cursor: pointer;
    opacity: 0;
    animation: barIn .4s ease 5.6s forwards;
  }
  .replay:hover { background: rgba(53,240,206,.14); }

  .note {
    position: fixed; bottom: 16px; left: 50%; transform: translateX(-50%);
    z-index: 60;
    font: 8.5px ui-monospace, monospace; letter-spacing: .13em; color: rgba(74,96,110,.5);
    opacity: 0;
    animation: barIn .5s ease 5.8s forwards;
  }
  .note b { color: rgba(53,240,206,.7); font-weight: 400; }

  /* ═══════════════ 落地效果（3.66s 触发） ═══════════════ */

  /*
   * 这里**不做压扁**。
   *
   * squash & stretch 是给有物理重量的东西用的（球、角色、箱子）。
   * Z 是一个符号 —— 符号可以发光、缩放、被吸附，但不该有形变。
   * 而且它落到标题栏是「归位」，不是「砸下来」，冲击感本身就是错的语义。
   *
   * 换成 UI 语言里的「锁定」：四角括号从外收拢、套住它、闪一下、消失。
   */
  .layer-z {
    animation: zIn .7s ease 3.00s forwards;
  }

  /* 落地锁定：四角括号收拢 */
  .reticle {
    position: fixed;
    left: 26px; top: 20px;
    width: 62px; height: 62px;
    margin: -31px 0 0 -31px;
    pointer-events: none;
    z-index: 45;
    opacity: 0;
    animation: lockOn .62s cubic-bezier(.2,.85,.3,1) 3.64s forwards;
  }
  .reticle svg { display: block; width: 100%; height: 100%; overflow: visible; }
  @keyframes lockOn {
    0%   { opacity: 0; transform: scale(1.85) rotate(-7deg); }
    26%  { opacity: .95; }
    62%  { opacity: .7; transform: scale(1) rotate(0deg); }
    78%  { opacity: 1; }
    100% { opacity: 0; transform: scale(.94) rotate(0deg); }
  }

  /* Z 自身的高亮掠过：像被「确认」了一下 */
  @keyframes confirm {
    0%   { opacity: .55; }
    30%  { opacity: 1; }
    100% { opacity: .55; }
  }

  /* ② 冲击波 —— 三圈从落点扩散 */
  .shock {
    position: fixed;
    left: 26px; top: 20px;
    width: 26px; height: 26px;
    margin: -13px 0 0 -13px;
    border-radius: 50%;
    border: 1.4px solid var(--accent);
    transform: scale(.2);
    opacity: 0;
    pointer-events: none;
    z-index: 45;
  }
  @keyframes shockwave {
    0%   { transform: scale(.25); opacity: .95; }
    72%  { opacity: .22; }
    100% { transform: scale(4.4); opacity: 0; }
  }
  .shock-1 { animation: shockwave .82s cubic-bezier(.15,.7,.35,1) 3.66s forwards; }
  .shock-2 { animation: shockwave .92s cubic-bezier(.15,.7,.35,1) 3.78s forwards; }
  .shock-3 { animation: shockwave 1.02s cubic-bezier(.15,.7,.35,1) 3.92s forwards; }

  /* ③ 扫描线 —— 落地瞬间一道光掠过标题栏 */
  .scanline {
    position: fixed;
    left: 0; top: 37px;
    width: 100%; height: 1px;
    pointer-events: none;
    z-index: 46;
    opacity: 0;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(53,240,206,.75) 8%,
      rgba(160,245,255,.9) 16%,
      transparent 30%,
      transparent 100%
    );
    animation: scanlineRun .78s cubic-bezier(.2,.8,.3,1) 3.70s forwards;
  }
  @keyframes scanlineRun {
    0%   { opacity: 0; transform: translateX(-18%); }
    22%  { opacity: 1; }
    100% { opacity: 0; transform: translateX(58%); }
  }

  /* ④ 落点光斑 —— 一瞬间的亮 */
  .flash {
    position: fixed;
    left: 26px; top: 20px;
    width: 60px; height: 60px;
    margin: -30px 0 0 -30px;
    border-radius: 50%;
    pointer-events: none;
    z-index: 44;
    opacity: 0;
    background: radial-gradient(circle, rgba(53,240,206,.55) 0%, transparent 68%);
    animation: flashPop .5s ease-out 3.64s forwards;
  }
  @keyframes flashPop {
    0%   { opacity: 0; transform: scale(.4); }
    35%  { opacity: 1; transform: scale(1.1); }
    100% { opacity: 0; transform: scale(1.9); }
  }


  @media (prefers-reduced-motion: reduce) {
    * { animation-duration: .01ms !important; animation-delay: 0ms !important; }
  }
</style>
</head>
<body>

<div class="grid-bg"></div>

<!-- ═══════════ 主界面骨架 ═══════════ -->
<div class="app">
  <header class="topbar">
    <div class="brand">
      <span class="cn">生 境</span>
      <span class="en">HABITAT</span>
      <span class="sub">SYSTEMIC ECOSYSTEM FOR AGENTS</span>
    </div>
  </header>

  <div class="body">
    <!-- 左栏 -->
    <aside class="rail-left">
      <div class="ghost"></div>
      <div class="ghost"></div>
      <div class="ghost"></div>
      <div class="ghost"></div>
      <div class="ghost"></div>
    </aside>

    <!-- 中间 -->
    <main class="main">
      <div class="bubble">
        <div class="avatar"></div>
        <div>
          <div class="line w40" style="width:90px;background:rgba(53,240,206,.15)"></div>
          <div class="line w85"></div>
          <div class="line w60"></div>
        </div>
      </div>
      <div class="bubble">
        <div class="avatar"></div>
        <div>
          <div class="line w40" style="width:70px;background:rgba(53,240,206,.12)"></div>
          <div class="line w60"></div>
        </div>
      </div>
      <div class="bubble">
        <div class="avatar"></div>
        <div>
          <div class="line w40" style="width:110px;background:rgba(53,240,206,.14)"></div>
          <div class="line w85"></div>
          <div class="line w85" style="width:64%"></div>
          <div class="line w40"></div>
        </div>
      </div>
    </main>

    <!-- 右栏 -->
    <aside class="rail-right">
      <div class="radar"></div>
      <div class="ghost"></div>
      <div class="ghost"></div>
    </aside>
  </div>
</div>

<!-- ═══════════ 落地特效 ═══════════ -->
<div class="flash"></div>
<div class="reticle">
  <svg viewBox="0 0 100 100" fill="none" stroke="#35f0ce" stroke-width="2.6" stroke-linecap="round">
    <path d="M6 30 V6 H30" />
    <path d="M70 6 H94 V30" />
    <path d="M94 70 V94 H70" />
    <path d="M30 94 H6 V70" />
  </svg>
</div>
<div class="shock shock-1"></div>
<div class="shock shock-2"></div>
<div class="shock shock-3"></div>
<div class="scanline"></div>

<!-- ═══════════ 中央 logo（会飞左上角） ═══════════ -->
<div class="logo-stage" id="logoStage">
  <div class="layer layer-u" id="layerU"></div>
  <div class="layer layer-z" id="layerZ"></div>
</div>

<!-- ═══════════ 启动文字 ═══════════ -->
<div class="wordmark">
  <div class="cn">生 境</div>
  <div class="en">HABITAT</div>
  <div class="tag">SYSTEMIC ECOSYSTEM FOR AGENTS</div>
</div>

<div class="bar-wrap">
  <div class="bar"><i></i></div>
  <div class="status" id="status"></div>
</div>

<button class="replay" onclick="location.reload()">↻ 重播</button>
<div class="note">U 生长 → 移动中变形 → 停靠左上角 → <b>界面各块依次显现</b></div>

<script>
const A = "#35f0ce";

/* ─── U · 双生脉 ─── */
function buildU() {
  const BR = [
    ["M50 54 L30 33", "u-b1", 29],
    ["M50 54 L70 33", "u-b2", 29],
    ["M50 70 L33 51", "u-b3", 26],
    ["M50 70 L67 51", "u-b4", 26],
  ];
  const TIPS = [[30, 33, "u-t1", ".85"], [70, 33, "u-t2", ".85"], [33, 51, "u-t3", ".6"], [67, 51, "u-t4", ".6"]];
  let s = "";
  for (const [d, cls, len] of BR) {
    s += `<path class="${cls}" d="${d}" stroke="${A}" stroke-width="1.9" stroke-linecap="round" opacity=".68" fill="none"/>`;
  }
  for (const [x, y, cls, op] of TIPS) {
    s += `<circle class="u-tip ${cls}" cx="${x}" cy="${y}" r="2.6" fill="${A}" opacity="${op}"/>`;
  }
  return `<svg viewBox="0 0 100 100" width="320" height="320">
    <defs>
      <filter id="gU" x="-70%" y="-70%" width="240%" height="240%">
        <feGaussianBlur stdDeviation="2.6" result="b"/>
        <feMerge><feMergeNode in="b"/><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
      </filter>
    </defs>
    <g filter="url(#gU)">
      <path class="u-trunk" d="M50 88 V54" stroke="${A}" stroke-width="2.9" stroke-linecap="round" opacity=".9" fill="none"/>
      ${s}
      <line x1="40" y1="88" x2="60" y2="88" stroke="${A}" stroke-width="2.2" stroke-linecap="round" opacity=".38"/>
      <circle class="u-halo" cx="50" cy="54" r="11" fill="${A}" opacity="0"/>
      <circle class="u-core" cx="50" cy="54" r="4.2" fill="${A}" opacity="0"/>
    </g>
  </svg>`;
}

/* ─── Z · 电路巢 ─── */
function buildZ() {
  const HEX = "M50 8 L87 29 L87 71 L50 92 L13 71 L13 29 Z";
  return `<svg viewBox="0 0 100 100" width="320" height="320">
    <defs>
      <filter id="gZ" x="-70%" y="-70%" width="240%" height="240%">
        <feGaussianBlur stdDeviation="2.6" result="b"/>
        <feMerge><feMergeNode in="b"/><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
      </filter>
    </defs>
    <g filter="url(#gZ)">
      <path class="z-hex" d="${HEX}" fill="none" stroke="${A}" stroke-width="2.2"
            stroke-linejoin="round" opacity=".6"/>
      <g class="z-legs">
        <path d="M34 76 L34 62 L44 56" fill="none" stroke="${A}" stroke-width="1.9" stroke-linecap="round"/>
        <path d="M50 80 L50 62" fill="none" stroke="${A}" stroke-width="1.9" stroke-linecap="round"/>
        <path d="M66 76 L66 62 L56 56" fill="none" stroke="${A}" stroke-width="1.9" stroke-linecap="round"/>
      </g>
      <circle class="z-core" cx="50" cy="52" r="7" fill="${A}" opacity="0"/>
    </g>
  </svg>`;
}

document.getElementById("layerU").innerHTML = buildU();
document.getElementById("layerZ").innerHTML = buildZ();

/* ─── 状态文字 ─── */
const STEPS = [
  [0.3, "初始化"],
  [0.85, "加载角色档案"],
  [1.45, "唤醒核心"],
  [1.95, "挂载凭据"],
  [2.45, "绘制坐标"],
];
const st = document.getElementById("status");
STEPS.forEach(([t, label]) => {
  setTimeout(() => { st.textContent = "· " + label; }, t * 1000);
});
