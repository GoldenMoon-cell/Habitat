/**
 * 三鲸空间 · 会话与消息数据
 *
 * 角色档案（人设、六维、关系网）在 `personas.ts` —— 那里是单一来源。
 * 这个文件只管"会话里发生了什么"。
 */

import {
  PERSONAS,
  PERSONA_MAP,
  AXIS_ORDER,
  deriveGroupAxes,
  type StaticAxes,
  type Persona,
  type PersonaId,
} from "./personas";

export type { Persona, PersonaId, StaticAxes };

export type AgentId = PersonaId;
export type AuthorId = "me" | AgentId;
/**
 * 会话 id。
 *
 * `"group"` 是默认群（保留下来兼容旧数据），自建的群用 `grp-2`、`grp-3`……
 * 其余都是单聊，id 等于角色 id。
 */
export type ConvId = "group" | `grp-${string}` | AgentId;

/** 这个会话 id 是不是群聊 */
export const isGroupId = (id: string): boolean =>
  id === "group" || id.startsWith("grp-");

export type Presence = Persona["presence"];

/** 角色即档案，避免两处维护同一份字段 */
export type Agent = Persona;

export const AGENTS: Agent[] = PERSONAS;
export const AGENT_MAP: Record<AgentId, Agent> = PERSONA_MAP as Record<AgentId, Agent>;

export interface VoiceClip {
  seconds: number;
  /** 0..1 的振幅数组，用于绘制声波 */
  peaks: number[];
  transcript: string;
}

export interface Attachment {
  name: string;
  meta: string;
  kind: "file" | "image";
}

export interface Reaction {
  emoji: string;
  count: number;
}

export interface Message {
  id: string;
  conv: ConvId;
  author: AuthorId;
  time: string;
  text?: string;
  voice?: VoiceClip;
  attach?: Attachment;
  reactions?: Reaction[];
  replyTo?: string;
  /** 已撤回：内容不再渲染，只留一行占位 */
  recalled?: boolean;
  /** 编辑过的消息，时间后面会标「已编辑」 */
  edited?: boolean;
  /** 正在流式输出（只做视觉，不接后端） */
  streaming?: boolean;
  /** 系统事件条（居中细线），用于快捷命令的可见反馈 */
  system?: {
    label: string;
    detail?: string;
    accent?: string;
  };
}

/* ── 角色：由 personas.ts 提供（单一来源） ──────────────────── */

