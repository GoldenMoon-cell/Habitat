export interface EmotionAxis {
  label: string;
  value: number;
}

/**
 * 六维：不再手写。
 * 单人 → 读 personas.ts 的 axes；
 * 群聊 → 核心成员平均 + 同场摩擦/起哄加成（deriveGroupAxes）。
 */
const toAxes = (a: StaticAxes): EmotionAxis[] =>
  AXIS_ORDER.map((k) => ({ label: k, value: a[k] }));

export const EMOTION: Record<ConvId, EmotionAxis[]> = (() => {
  const out = {} as Record<ConvId, EmotionAxis[]>;
  out.group = toAxes(deriveGroupAxes());
  PERSONAS.forEach((p) => {
    out[p.id] = toAxes(p.axes);
  });
  return out;
})();

